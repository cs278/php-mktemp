{
    "name": "cs278/mktemp",
    "description": "Create temporary files and directories using PHP safely.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Smith",
            "email": "chris@cs278.org"
        }
    ],
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Cs278\\Mktemp\\": "src/"
        }
    },
    "require": {
        "php": "^7.4 || ^8"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.3.0",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "bc-check": "vendor-bin/bc-check/vendor/bin/roave-backward-compatibility-check",
        "cs": "vendor-bin/cs/vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        },
        "lock": false
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        }
    }
}
